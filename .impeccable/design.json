      "css": ".ds-search-wrap{position:relative;min-width:240px}.ds-search-icon{position:absolute;left:10px;top:13px;color:#64748b}.ds-search{font-family:Inter,system-ui,-apple-system,sans-serif;width:100%;min-height:38px;background:var(--surface,#fff);color:#0f172a;border:1px solid #cbd5e1;border-radius:8px;padding:8px 6px 8px 28px;font-size:.8125rem;line-height:1.5;caret-color:var(--accent,#a84613)}.ds-search::placeholder{color:var(--muted,#526170);opacity:1}.ds-search:focus{border-color:#f97316}.ds-search:focus-visible{outline:3px solid var(--accent,#a84613);outline-offset:3px;}@media(max-width:600px){.ds-search-wrap{min-width:0}.ds-search{font-size:1rem}}"
