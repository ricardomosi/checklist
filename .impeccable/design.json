      "html": "<nav class=\"ds-nav\" aria-label=\"Áreas de gestão\"><button aria-current=\"page\">Manutenções</button><button>SOS</button><button>Indicadores</button><button>Checklists</button><button>Frotas</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:6px;width:184px}.ds-nav button{font-family:Inter,system-ui,-apple-system,sans-serif;min-height:44px;width:100%;text-align:left;padding:10px 12px;border:0;border-radius:7px;font-size:.8125rem;line-height:1.5;font-weight:550;background:transparent;color:var(--muted,#526170);transition:background-color .15s cubic-bezier(.4,0,.2,1)}.ds-nav button:hover{background:#f1f5f9}.ds-nav button[aria-current=page]{background:var(--accent-soft,#fff2e8);color:#963e10;font-weight:700}.ds-nav button:focus-visible{outline:3px solid var(--accent,#a84613);outline-offset:3px;}@media(max-width:1000px){.ds-nav{width:100%;flex-direction:row;overflow-x:auto;gap:4px}.ds-nav button{width:auto;white-space:nowrap;flex-shrink:0}}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}"
    },
