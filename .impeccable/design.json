      "css": ".ds-urgent{font-family:Inter,system-ui,-apple-system,sans-serif;display:inline;background:rgb(239 68 68 / .2);color:#b91c1c;border-radius:4px;padding:0 6px;font-size:.8125rem;line-height:1.5;font-weight:700}"
