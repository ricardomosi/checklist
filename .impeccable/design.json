      "css": ".ds-send{font-family:Inter,system-ui,-apple-system,sans-serif;width:100%;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;border:0;border-radius:12px;background:var(--accent,#a84613);color:var(--surface,#fff);font-size:1.125rem;line-height:1.75rem;font-weight:700;box-shadow:0 4px 6px -1px rgb(0 0 0 / .1),0 2px 4px -2px rgb(0 0 0 / .1);transition:transform .1s cubic-bezier(.4,0,.2,1),box-shadow .1s,background-color .15s}.ds-send:hover{background:#87370d}.ds-send:focus-visible{outline:3px solid var(--accent,#a84613);outline-offset:3px;}.ds-send:active{transform:translateY(3px) scale(.985);box-shadow:inset 0 3px 6px rgba(0,0,0,.35)}.ds-send:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-send{transition:none}}"
    },
